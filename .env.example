# Baked into the client at build time (Netlify → Site settings → Environment variables).
# Must include the /presence path — bare wss://host fails on the GMC Render service.
VITE_WS_URL=wss://gmc-presence.onrender.com/presence

# Optional: HTTP origin for the staff analytics API if it differs from VITE_WS_URL.
# (ws→http is derived automatically from VITE_WS_URL when unset.)
VITE_ANALYTICS_URL=https://gmc-presence.onrender.com

# Optional: local presence port when running `npm run server` / `npm run dev`
# PRESENCE_PORT=8787

# --- Presence process (Render / local `npm run server`) ---
# Staff dashboard token: open /analytics.html and enter this value (local default gmc-dev).
# ANALYTICS_TOKEN=gmc-dev
# ENGAGEMENT_PATH=./server/data/engagement.json
# ANALYTICS_PATH=./server/data/analytics.json

# --- Supabase (analytics + hearts + comments) ---
# 1. Create a project at https://supabase.com
# 2. SQL Editor → paste and run server/schema.sql
# 3. Project Settings → API → copy URL + service_role into .env (never commit service_role)
# 4. Restart `npm run dev` — log should say: [presence] Supabase ready
# 5. Optional check: node scripts/verify-supabase.mjs
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client (optional — hall uses presence; presence uses the service role above)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=
