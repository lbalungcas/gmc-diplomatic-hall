# ── Frontend (Netlify → Site settings → Environment variables). Safe to expose. ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The publishable (or legacy anon) key. Never the service_role / secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_EVENT_SLUG=yim-2026
# Cloudflare Turnstile site key. Leave empty locally (the function must then have ALLOW_NO_TURNSTILE=true).
VITE_TURNSTILE_SITE_KEY=

# ── Edge Function secrets — set with `supabase secrets set --env-file supabase/.env`, NEVER in Netlify. ──
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.)
# APP_URL=https://youthinnovationsmarketplace.org/register
# EXTRA_ALLOWED_ORIGINS=http://localhost:5174
# EVENT_SLUG=yim-2026
# RESEND_API_KEY=re_...
# EMAIL_FROM=Youth Innovations Marketplace <register@youthinnovationsmarketplace.org>
# TURNSTILE_SECRET_KEY=0x...
# ALLOW_NO_TURNSTILE=false

# ── scripts/seed-fake.mjs only (local machine). ──
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
